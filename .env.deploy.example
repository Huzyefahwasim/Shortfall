# Copy to .env.deploy.local and add the real key there.
# Deployment credentials only: do not inject this file into app containers.
VULTR_API_KEY=
# Optional: fill these only if a VM and SSH key already exist.
VULTR_INSTANCE_IP=
VULTR_SSH_USER=
# Path to the private key on this computer, not its contents.
VULTR_SSH_PRIVATE_KEY_PATH=
